import { NextFunction, Request, Response } from "express";
import { FEATURE_NAME_PASCALService } from "./FEATURE_NAME_KEBAB.service";

export class FEATURE_NAME_PASCALController {
  private FEATURE_NAMEService: FEATURE_NAME_PASCALService;

  constructor() {
    this.FEATURE_NAMEService = new FEATURE_NAME_PASCALService();
  }

  getAll = async (req: Request, res: Response, next: NextFunction) => {
    try {
      const items = await this.FEATURE_NAMEService.findAll();
      res.json({ success: true, data: items });
    } catch (error) {
      next(error);
    }
  };

  getById = async (req: Request, res: Response, next: NextFunction) => {
    try {
      const { id } = req.params;
      const item = await this.FEATURE_NAMEService.findById(id as string);
      res.json({ success: true, data: item });
    } catch (error) {
      next(error);
    }
  };

  create = async (req: Request, res: Response, next: NextFunction) => {
    try {
      const item = await this.FEATURE_NAMEService.create(req.body);
      res.status(201).json({ success: true, data: item });
    } catch (error) {
      next(error);
    }
  };

  update = async (req: Request, res: Response, next: NextFunction) => {
    try {
      const { id } = req.params;
      const item = await this.FEATURE_NAMEService.update(id as string, req.body);
      res.json({ success: true, data: item });
    } catch (error) {
      next(error);
    }
  };

  delete = async (req: Request, res: Response, next: NextFunction) => {
    try {
      const { id } = req.params;
      await this.FEATURE_NAMEService.delete(id as string);
      res.status(204).send();
    } catch (error) {
      next(error);
    }
  };
}
