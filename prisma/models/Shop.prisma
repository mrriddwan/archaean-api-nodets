model Shop {
  id        String    @id @default(uuid())
  name      String
  description String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")
  ownerId   String    @map("owner_id") @unique
  owner     User      @relation(fields: [ownerId], references: [id])
  products  Product[]

  @@map("shops")
}