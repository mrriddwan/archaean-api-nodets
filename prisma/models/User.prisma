model User {
  id         String    @id @default(ulid())
  email      String    @unique
  name       String?
  password   String?
  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt

  //relation
  accessTokens  Token[]
  orders        Order[]
  userOnRoles   UserOnRoles[]
  oAuthAccounts OAuthAccount[]

  @@map("users")
}
